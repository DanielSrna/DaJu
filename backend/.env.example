# Servidor
NODE_ENV=development
PORT=4000

# Base de datos (MongoDB Atlas en producción / local en desarrollo)
MONGODB_URI=mongodb://localhost:27017/mainplataform

# Seguridad
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# CORS - dominios permitidos (vitrina y panel)
CORS_ORIGINS=http://localhost:5173

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Nodemailer
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=tu-usuario
SMTP_PASS=tu-password

# Cloudinary (logos y PDFs de clientes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
