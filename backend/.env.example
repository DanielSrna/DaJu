# Servidor
NODE_ENV=development
PORT=4000

# Base de datos (MongoDB Atlas en producción / local en desarrollo)
MONGODB_URI=mongodb://localhost:27017/mainplataform

# Seguridad JWT
JWT_SECRET=cambia-este-secreto-en-produccion-min-16
JWT_REFRESH_SECRET=cambia-este-refresh-secreto-min-16
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
COOKIE_SECURE=false

# URL pública de la app (para callbacks de la pasarela de pagos)
APP_URL=

# CORS - dominios permitidos (vitrina y panel)
CORS_ORIGINS=http://localhost:5173

# ePayco - pasarela de pagos (Colombia) [esperando formalización del negocio]
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_CUST_ID_CLIENTE=
EPAYCO_WEBHOOK_URL=

# Pasarela activa: mercadopago | epayco
PAYMENT_PROVIDER=mercadopago

# MercadoPago - pasarela activa (persona natural + modo test)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_NOTIFICATION_URL=

# Correo (Gmail SMTP)
EMAIL_USER=
EMAIL_APP_PASSWORD=
CONTACT_EMAIL=

# Seed de administrador (solo se usa en la migración)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Nodemailer alternativo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cloudinary (logos y PDFs de clientes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# ---- MercadoPago (pasarela principal: PAYMENT_PROVIDER=mercadopago) ----
# Token de aplicación: modo prueba para testear (cobros con tarjeta de prueba),
# modo producción para cobros reales. Se crea en https://www.mercadopago.com.ar/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_NOTIFICATION_URL=
# Misma llave que se configura en la app de MP para firmar webhooks (IPN v1)
MERCADOPAGO_WEBHOOK_SECRET=

# Rate-limit: activarlo explícitamente en producción (por defecto desactivado)
# RATE_LIMIT_ENABLED=true
